# Deixe vazio em desenvolvimento: o Vite faz proxy de /api para http://localhost:8080
# Em produção, use a origem completa da API (mesmo site do frontend para o cookie HttpOnly).
VITE_API_BASE_URL=
# Opcional em dev (o Vite faz proxy de /ws). Em produção o WebSocket precisa apontar
# direto para a API, porque a Vercel não faz upgrade de WebSocket:
# VITE_WS_URL=wss://api.devrats.app/ws
VITE_WS_URL=
VITE_APP_NAME=DevRats
