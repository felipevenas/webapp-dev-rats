# Leave empty in development: Vite proxies /api to http://localhost:8080.
# In production, use the full API origin (same site as the frontend for the HttpOnly cookie).
VITE_API_BASE_URL=
# Optional in development (Vite proxies /ws). In production, the WebSocket must point
# directly to the API because Vercel does not upgrade WebSocket connections:
# VITE_WS_URL=wss://api.devrats.app/ws
VITE_WS_URL=
VITE_APP_NAME=DevRats
